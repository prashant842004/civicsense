# Copy this file to ".env" and fill in your values.

SECRET_KEY=change-this-to-a-long-random-string

# ---- Option A: MySQL using separate settings (recommended) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=civicsense

# ---- Option B: one full URL (overrides the DB_* settings above) ----
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/civicsense

# Leave DB_HOST and DATABASE_URL both unset to use the local SQLite file.
